# Polymarket Bot Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your Ethereum private key (KEEP THIS SECRET!)
# This wallet should have USDC on Polygon network
PRIVATE_KEY=your_private_key_here

# RPC Endpoint for Polygon network
# You can use public RPCs or get one from Alchemy/Infura
RPC_ENDPOINT=https://polygon-rpc.com

# Trading Mode
# Set to "false" to enable real trading (WARNING: USE AT YOUR OWN RISK)
DRY_RUN=true

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
